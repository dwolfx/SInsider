{
  "name": "si-seo",
  "version": "1.0.0",
  "description": "Plugin de SEO profissional e jornalístico para o Saúde Insider",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
